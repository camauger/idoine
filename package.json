{
    "name": "atelier-st-elme",
    "version": "1.0.0",
    "description": "Site web de Atelier St-Elme",
    "main": "Gruntfile.js",
    "scripts": {
        "dev": "grunt dev",
        "dev:py": "python scripts/dev_server.py",
        "dev:netlify": "node scripts/run-netlify-dev-from-root.js",
        "dev:functions": "netlify functions:serve -p 9999",
        "reset-netlify-deno": "node scripts/reset-netlify-deno-cache.js",
        "ensure-netlify-deno-version": "node scripts/ensure-netlify-deno-version-file.js",
        "watch": "grunt watchOnly",
        "build": "grunt build && npm run seo",
        "sitemap": "node scripts/seo/generate-sitemap.mjs --url https://atelierstelme.ca",
        "robots": "node scripts/seo/generate-robots.mjs --url https://atelierstelme.ca",
        "verify-seo": "node scripts/seo/verify-seo.mjs --url https://atelierstelme.ca",
        "seo": "npm run sitemap && npm run robots && npm run verify-seo",
        "audit": "npm audit --audit-level=moderate || true",
        "audit:fix": "npm audit fix || true"
    },
    "homepage": "https://atelierstelme.ca",
    "author": "Christian Amauger <christian@amauger.com>",
    "license": "MIT",
    "dependencies": {
        "@neondatabase/serverless": "^0.10.0",
        "jsonwebtoken": "^9.0.3"
    },
    "devDependencies": {
        "@fontsource/cinzel-decorative": "^5.2.8",
        "@fontsource/montserrat": "^5.2.8",
        "@fortawesome/fontawesome-free": "^7.1.0",
        "@lodder/grunt-postcss": "^3.1.1",
        "autoprefixer": "^10.4.20",
        "gray-matter": "^4.0.3",
        "grunt-cli": "^1.5.0",
        "grunt-concurrent": "^3.0.0",
        "grunt-contrib-clean": "^2.0.0",
        "grunt-contrib-connect": "^5.0.1",
        "grunt-contrib-copy": "^1.0.0",
        "grunt-contrib-cssmin": "^4.0.0",
        "grunt-contrib-watch": "^1.1.0",
        "grunt-mkdir": "^1.1.0",
        "grunt-newer": "^1.3.0",
        "grunt-sass": "^3.1.0",
        "grunt-shell": "^3.0.1",
        "load-grunt-tasks": "^5.1.0",
        "marked": "^15.0.7",
        "netlify-cli": "^23.9.3",
        "postcss": "^8.5.6",
        "sass": "^1.69.0",
        "sharp": "^0.34.5"
    }
}
