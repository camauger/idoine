# ============================================================
# IDOINE - Variables d'environnement
# ============================================================
# Copiez ce fichier vers .env et modifiez les valeurs.
#
# Usage:
#   cp env.example .env
#
# Note: Ces variables sont optionnelles. La plupart des
# configurations se font dans src/config/site_config.yaml
# ============================================================

# ------------------------------------------------------------
# DÉVELOPPEMENT
# ------------------------------------------------------------

# URL du site en développement local
# Utilisé par certains scripts pour générer les URLs absolues
SITE_URL=http://localhost:9000

# URL de l'API backend (cours, inscriptions). Lu au build et injecté dans les pages.
# En local : http://127.0.0.1:8000 (adresse où tourne uvicorn, voir docs/GUIDE_BD.md section 5)
# En prod : URL publique du backend (fournie par Render, Railway, etc. après déploiement)
# ATELIER_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------
# OPTIONS DE BUILD
# ------------------------------------------------------------

# Afficher les emojis/icônes dans les logs du terminal
# Désactiver si votre terminal ne les supporte pas bien
IDOINE_USE_ICONS=true

# Mode verbose pour le débogage
# Affiche plus de détails pendant le build
IDOINE_VERBOSE=false

# ------------------------------------------------------------
# PRODUCTION (Netlify) + API serverless (Neon)
# ------------------------------------------------------------
# Ces variables sont automatiquement injectées par Netlify
# lors du déploiement. Ne les définissez pas localement.
#
# DEPLOY_URL - URL du déploiement (preview ou production)
# CONTEXT - Contexte de build (production, deploy-preview, branch-deploy)
# BRANCH - Branche Git en cours de build
#
# DATABASE_URL - Pour les Netlify Functions (api cours/inscriptions).
#   À définir dans Netlify > Site settings > Environment variables.
#   Utiliser l’URL « Pooled connection » du dashboard Neon (crucial en serverless).
#   En local avec `netlify dev`, créer un .env à la racine avec DATABASE_URL=postgresql://...
#
# Si DATABASE_URL est défini sur Netlify, on peut laisser ATELIER_API_URL vide en prod :
# le site appellera /api/cours et /api/inscriptions sur le même domaine.
# ============================================================
